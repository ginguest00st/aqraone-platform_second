# Salin file ini menjadi `.env` atau `.env.local` untuk development.
# JANGAN PERNAH meng-commit file `.env` atau nilai rahasia ke repository Git!

# --- SUPABASE CONFIGURATION (Frontend Client) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- SUPABASE CONFIGURATION (Server / Edge Functions Only) ---
# Kredensial di bawah ini HANYA disetel di dashboard Supabase / Edge Functions Secrets.
# TIDAK BOLEH diekspos ke frontend (tanpa prefix VITE_).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- FINNET PAYMENT GATEWAY CREDENTIALS (Server / Edge Functions Only) ---
# [BUTUH DOKUMENTASI RESMI FINNET]
FINNET_BASE_URL=https://sandbox.finnet.co.id/api/v1
FINNET_MERCHANT_ID=MERCHANT_AQRAPANA_001
FINNET_MERCHANT_KEY=finnet_secret_key_placeholder
FINNET_CALLBACK_SECRET=webhook_hmac_secret_placeholder
